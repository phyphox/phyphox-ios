"NSMicrophoneUsageDescription" = "மற்ற உணர்விகளைப் போலவே phyphox-ம் ஒலிவாங்கியிலிருந்து ஒலியைப் பதிவுசெய்து, தேர்ந்தெடுக்கப்பட்ட பரிசோதனையின்படி பகுப்பாய்வு செய்கிறது. பயனர் ஏற்றுமதி செயலைப் பயன்படுத்தி அவ்வாறு செய்யத் தேர்வுசெய்தால் மட்டுமே தரவு பயன்பாட்டிலிருந்து ஏற்றுமதி செய்யப்படும்.";
"NSLocationWhenInUseUsageDescription" = "மற்ற உணர்விகளைப் போலவே GPS-லிருந்தும் இருப்பிடத் தரவை phyphox பதிவுசெய்து, தேர்ந்தெடுக்கப்பட்ட பரிசோதனையின்படி பகுப்பாய்வு செய்கிறது. பயனர் ஏற்றுமதி செயலைப் பயன்படுத்தி அவ்வாறு செய்யத் தேர்வுசெய்தால் மட்டுமே தரவு பயன்பாட்டிலிருந்து ஏற்றுமதி செய்யப்படும்.";
"NSPhotoLibraryAddUsageDescription" = "பரிசோதனை பட்டியலில் \"ஸ்கிரீன்ஷாட்டைப் பகிர்\" என்பதைத் தேர்ந்தெடுத்தால், phyphox உங்கள் புகைப்பட நூலகத்தில் ஸ்கிரீன்ஷாட்களைச் சேர்க்க முடியும்.";
"NSMotionUsageDescription" = "இயற்பியல் பரிசோதனைகளில் அவற்றைப் பயன்படுத்த அனுமதிக்க phyphox உங்கள் தொலைபேசியின் உணர்விகளைப் படிக்கிறது.";
"NSCameraUsageDescription" = "தனிப்பட்ட பரிசோதனை உள்ளமைவுகளைச் சேர்க்கப் பயன்படுத்தக்கூடிய QR குறியீடுகளை ஸ்கேன் செய்ய phyphox ஒளிப்படவியை பயன்படுத்துகிறது. ஒளிப்படவி ஒளியியல் பரிசோதனைகள் மற்றும் ஆழ உணரி (LiDAR/ToF) ஐப் பயன்படுத்தி சோதனைகளுக்கான அளவீட்டு கருவியாகவும் பயன்படுத்தப்படுகிறது.";
"NSBluetoothPeripheralUsageDescription" = "வெளிப்புற Bluetooth உணர்விகளை படிக்கவும், வெளிப்புற Bluetooth சாதனங்களுக்கு தரவை எழுதவும் phyphox-ஆல் முடியும். இந்த அம்சம் மற்றும் ஆதரிக்கப்படும் சாதனங்கள் பற்றி http://phyphox.org/ble இல் மேலும் அறியலாம்.";
"NSBluetoothAlwaysUsageDescription" = "வெளிப்புற Bluetooth உணர்விகளை படிக்கவும், வெளிப்புற Bluetooth சாதனங்களுக்கு தரவை எழுதவும் phyphox-ஆல் முடியும். இந்த அம்சம் மற்றும் ஆதரிக்கப்படும் சாதனங்கள் பற்றி http://phyphox.org/ble இல் மேலும் அறியலாம்.";
