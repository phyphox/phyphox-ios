<phyphox version="1.4" locale="en">
    <title>title</title>
    <category>category</category>
    <icon>icon</icon>
    <description>description</description>
    <link label="l0">http://test.test</link>
    <data-containers>
        <container>buffer</container>
        <container size="2" init="1,2" clearGroup="g1">buffer2</container>
        <container clearGroup="_">buffer3</container>
    </data-containers>
    <translations>
        <translation locale="de">
            <title>titlede</title>
            <category>categoryde</category>
            <description>descriptionde</description>
        </translation>
   </translations>
    <input>
        <sensor type="linear_acceleration" rate="0">
            <output component="abs">buffer</output>
            <output component="t">buffer</output>
            <output component="x">buffer</output>
            <output component="y">buffer</output>
            <output component="z">buffer</output>
        </sensor>
        <location>
            <output component="lat">buffer</output>
            <output component="lon">buffer</output>
            <output component="z">buffer</output>
            <output component="v">buffer</output>
            <output component="dir">buffer</output>
            <output component="accuracy">buffer</output>
            <output component="zAccuracy">buffer</output>
            <output component="t">buffer</output>
            <output component="satellites">buffer</output>
            <output component="status">buffer</output>
        </location>
        <audio>
            <output>buffer</output>
            <output component="rate">buffer</output>
        </audio>
        <camera x1="0.4" x2="0.6" y1="0.4" y2="0.6" auto_exposure="true" aeStrategy="prioritizeFramerate" aeFPSTarget="30" locked="focus_distance=0" feature="photometric">
            <output component="luminance">buffer</output>
            <output component="t">buffer2</output>
        </camera>
    </input>
    <output>
        <audio>
            <input>buffer</input>
            <tone waveform="square">
                <input parameter="frequency" type="value">440</input>
                <input parameter="amplitude" type="value">1</input>
                <input parameter="duration" type="value">1</input>
                <input parameter="pan" type="value">-0.5</input>
            </tone>
            <noise>
                <input parameter="amplitude">buffer</input>
                <input parameter="duration" type="value">1</input>
                <input parameter="pan">buffer</input>
            </noise>
        </audio>
        <flashlight>
            <input parameter="intensity">buffer</input>
            <input parameter="frequency" type="value">10</input>
            <input parameter="dutycycle" type="value">0.5</input>
        </flashlight>
    </output>
    <views>
        <view label="v1">
            <edit label="l1">
                <output>buffer</output>
            </edit>
            <value label="l2">
                <input>buffer</input>
            </value>
            <button label="l3">
                <input type="value">0</input>
                <output>buffer</output>
            </button>
            <separator height="1" visibility="buffer"/>
            <image src="img.png" scale="0.5" visibility="buffer"/>
            <info label="l4" visibility="buffer"/>
            <graph label="l6" labelX="l7" labelY="l8" interpolateMapColors="false">
                <input axis="x">buffer</input>
                <input axis="y">buffer</input>
            </graph>
            <graph label="l6b" labelX="l7" labelY="l8" pickLabel="l6c">
                <input axis="x">buffer</input>
                <input axis="y">buffer</input>
                <output axis="x" label="l6d">buffer</output>
                <output axis="xcal" label="l6e">buffer</output>
                <output axis="y" label="l6f">buffer</output>
                <output axis="z" label="l6g">buffer</output>
                <output axis="x" label="l6h">buffer</output>
            </graph>
        </view>
    </views>
    <analysis>
        <append>
            <input>buffer</input>
            <output>buffer</output>
        </append>

        <butterworth>
            <input as="y">buffer</input>
            <input as="x">buffer2</input>
            <input as="n" type="value">4</input>
            <input as="cutoff" type="value">10</input>
            <input as="cutoffLow" type="value">1</input>
            <output as="filtered">buffer</output>
        </butterworth>

        <imagedecode>
            <input>buffer</input>
            <output as="width">buffer</output>
            <output as="height">buffer</output>
            <output as="r">buffer</output>
            <output as="g">buffer</output>
            <output as="b">buffer</output>
            <output as="a">buffer</output>
            <output as="luma">buffer</output>
            <output as="luminance">buffer2</output>
        </imagedecode>

        <add>
            <input>buffer</input>
            <output>buffer</output>
        </add>

        <subtract>
            <input>buffer</input>
            <output>buffer</output>
        </subtract>

        <multiply>
            <input>buffer</input>
            <output>buffer</output>
        </multiply>

        <if>
            <input clear="false">buffer</input>
            <input type="value">0</input>
            <input clear="false">buffer</input>
            <input clear="false">buffer</input>
            <output>buffer</output>
        </if>

    </analysis>
    <export>
        <set name="n1">
            <data name="n2">buffer</data>
        </set>
    </export>
</phyphox>
